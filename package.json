{
  "name": "@patrickdk77/archive-defuse",
  "version": "0.1.1",
  "description": "Sanitize zip, tar, gzip, bzip2, zstd, Brotli, cab, 7z, xz and lzma archives. Detects path traversal, links out of the tree, device files, duplicate names, overlapping entries, hidden and prepended data, encrypted entries and compression bombs, hands every entry to file plugins, scores the risk, and writes a defused archive in the same format with no runtime dependencies.",
  "license": "MIT AND Apache-2.0",
  "author": "patrickdk77",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "archive-defuse": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build-test',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node scripts/write-esm-wrapper.js && node scripts/copy-notices.js",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run lint && npm run build && npm run build:test && mocha --timeout 120000 \"build-test/test/**/*.test.js\"",
    "prepare": "husky || true",
    "prepublishOnly": "npm run clean && npm test",
    "fixtures": "node scripts/make-fixtures.js && node scripts/make-lzma-fixtures.js && node scripts/make-deflate64-fixtures.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickdk77/archive-defuse.git"
  },
  "bugs": {
    "url": "https://github.com/patrickdk77/archive-defuse/issues"
  },
  "homepage": "https://github.com/patrickdk77/archive-defuse",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zip",
    "tar",
    "gzip",
    "bzip2",
    "zstd",
    "brotli",
    "cab",
    "archive",
    "sanitize",
    "sanitise",
    "scrub",
    "disarm",
    "defuse",
    "cdr",
    "zip-slip",
    "path-traversal",
    "zip-bomb",
    "security",
    "inspect",
    "scanner",
    "detect",
    "7z",
    "7zip",
    "xz",
    "lzma",
    "lzma2",
    "txz",
    "deflate64"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "chai": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
